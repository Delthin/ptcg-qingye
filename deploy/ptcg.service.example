[Unit]
Description=Private PTCG server and React client
After=network.target

[Service]
Type=simple
User=ptcg
Group=ptcg
WorkingDirectory=/opt/ptcg/source/ptcg-server
EnvironmentFile=/etc/ptcg/app.env
Environment=NODE_ENV=production
Environment=PTCG_BIND=127.0.0.1
Environment=PTCG_PORT=8080
Environment=STORAGE_TYPE=sqlite
Environment=STORAGE_DATABASE=/var/lib/ptcg/database.sq3
# Prefer supported Node 22 LTS at runtime; adjust PATH and validate this template.
# Node 20.19 is the inherited build baseline, EOL since April 2026.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash /opt/ptcg/source/deploy/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
StateDirectory=ptcg
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ptcg
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
