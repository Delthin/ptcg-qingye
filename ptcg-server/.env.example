# Copy to .env, chmod 600, replace placeholders before starting.
# Never commit .env. Production passwords must be generated independently.
STORAGE_TYPE=sqlite
STORAGE_DATABASE=database.sq3
# IMPORTANT: code uses lowercase `secret`, NOT SERVER_SECRET.
# Generate with: openssl rand -hex 32 (do not publish the output).
secret=REPLACE_WITH_GENERATED_SIGNING_SECRET_PLACEHOLDER
PTCG_DUO=1
PTCG_BIND=127.0.0.1
PTCG_PORT=8080
# Blank disables new private-room registrations. To enable them, generate a
# separate password (20+ chars); share privately, never put it in frontend env.
DUO_ROOM_PASSWORD=
# Legacy/non-duo registration password; leave blank in duo mode.
SERVER_PASSWORD=
PTCG_INVITE_TIMEOUT_MS=120000
PTCG_DISCONNECT_FORFEIT_MS=300000
# Optional: absolute frontend dist path; default ../ptcg-play-react/dist.
# PTCG_CLIENT_DIR=/opt/ptcg/source/ptcg-play-react/dist
